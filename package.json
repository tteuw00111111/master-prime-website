{
  "name": "master-prime-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && npm run build:client && npm run build:ssr && npm run prerender",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir dist-ssr",
    "prerender": "node scripts/prerender.mjs",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test-quote.mjs && node scripts/test-gaming-quote.mjs && node scripts/test-smartphone-quote.mjs && node scripts/test-smartphone-tracking.mjs && node scripts/test-computer-quote.mjs && node scripts/test-pc-build-quote.mjs && node scripts/test-iphone-purchase.mjs && node scripts/test-iphone-backgrounds.mjs && node scripts/validate-seo.mjs",
    "test:quote": "node scripts/test-quote.mjs",
    "catalog:import": "python3 scripts/import-notebook-catalog.py",
    "preview": "vite preview",
    "test:gaming": "node scripts/test-gaming-quote.mjs",
    "test:smartphone": "node scripts/test-smartphone-quote.mjs",
    "test:smartphone-tracking": "node scripts/test-smartphone-tracking.mjs",
    "test:computer": "node scripts/test-computer-quote.mjs",
    "test:pc-build": "node scripts/test-pc-build-quote.mjs",
    "catalog:games": "node scripts/import-pc-games.mjs",
    "test:iphone-purchase": "node scripts/test-iphone-purchase.mjs",
    "test:iphone-catalog-browser": "node scripts/test-iphone-catalog-browser.mjs",
    "test:iphone-purchase-browser": "node scripts/test-iphone-purchase-browser.mjs",
    "test:iphone-media-browser": "node scripts/test-iphone-media-browser.mjs",
    "test:iphone-18-browser": "node scripts/test-iphone-18-browser.mjs",
    "test:iphone-used-browser": "node scripts/test-iphone-used-browser.mjs",
    "test:iphone-trade-browser": "node scripts/test-iphone-trade-browser.mjs",
    "test:iphone-csp-browser": "node scripts/test-iphone-csp-browser.mjs"
  },
  "dependencies": {
    "@google/model-viewer": "^4.4.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-icons": "^5.3.0",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^22.5.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.21.5",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.12",
    "postcss": "^8.4.45",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.11",
    "terser": "^5.44.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.5",
    "vite-plugin-image-optimizer": "^2.0.3"
  }
}
